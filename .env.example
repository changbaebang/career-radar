OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Extraction/assessment provider: openai (default) or openrouter. See docs/PROVIDERS.md.
CAREER_RADAR_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional OpenRouter reasoning effort (intensity hint, not a token cap): none|minimal|low|medium|high|xhigh|max (see docs/PROVIDERS.md).
OPENROUTER_REASONING_EFFORT=
PORT=8000
CAREER_RADAR_DB_PATH=data/career-radar.db
# M5-E run traces (content-free per-call stage records for `pnpm diagnose`): directory, or CAREER_RADAR_TRACES=off to keep them in memory only.
CAREER_RADAR_TRACE_DIR=data/traces
CAREER_RADAR_TRACES=
